# RelayZero Environment Configuration
# Operating mode: "fixture" (synthetic demo) or "live" (connects to live Apertus serving)
APP_MODE=fixture

# Target model identifier
LLM_NAME=swiss-ai/Apertus-v1.5-8B

# Live OpenAI-compatible endpoint (required when APP_MODE=live)
LLM_BASE_URL=
LLM_API_KEY=

# Port binding (default 8000)
PORT=8000
