# RelayZero Environment Configuration
# Default target model: swiss-ai/Apertus-v1.5-8B
LLM_NAME=swiss-ai/Apertus-v1.5-8B

# Optional live OpenAI-compatible endpoint (e.g. local vLLM / TGI instance)
# Leave empty to utilize built-in Recorded Evaluation Replay mode
LLM_BASE_URL=
LLM_API_KEY=

# Port binding (default 8000)
PORT=8000
